-- §5.1 arsenals. Near-mirrored TTK; American = higher RPM / lower damage,
-- Russian = lower RPM / higher damage. Prices live here with the rest of the gun.

export type WeaponDef = {
	id: string,
	displayName: string,
	side: string, -- Enums.Side.Good | Terrorist
	tier: string, -- P0 P1 P2 P3 T2 T3 T4
	slot: string, -- "Secondary" | "Primary"
	price: number,
	damage: number,
	headshotMultiplier: number,
	rpm: number,
	magazine: number,
	reserve: number,
	reloadTime: number,
	baseSpread: number, -- radians, hip
	moveSpeedMultiplier: number,
	armorPenetration: number, -- 0..1 shifts armor split toward health
	pellets: number,
	falloffStart: number,
	falloffEnd: number,
	falloffMin: number,
	-- Procedural model tint (WeaponVisuals)
	color: Color3,
}

local function def(partial: WeaponDef): WeaponDef
	return partial
end

