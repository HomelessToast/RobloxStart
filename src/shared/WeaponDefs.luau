local byId: { [string]: WeaponDef } = {}
for _, weapon in WeaponDefs.List do
	byId[weapon.id] = weapon
end

function WeaponDefs.get(id: string): WeaponDef?
	return byId[id]
end

function WeaponDefs.forSide(side: string): { WeaponDef }
	local result = {}
	for _, weapon in WeaponDefs.List do
		if weapon.side == side then
			table.insert(result, weapon)
		end
	end
	return result
end

function WeaponDefs.defaultPistol(side: string): WeaponDef
	local id = if side == "Good" then "M9" else "Makarov"
	local weapon = byId[id]
	assert(weapon, "missing default pistol " .. id)
	return weapon
end

function WeaponDefs.isPistolTier(tier: string): boolean
	return tier == "P0" or tier == "P1" or tier == "P2" or tier == "P3"
end

function WeaponDefs.fireInterval(weapon: WeaponDef): number
	return 60 / math.max(weapon.rpm, 1)
end

return WeaponDefs
